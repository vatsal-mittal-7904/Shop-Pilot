{
  "name": "merchant-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "demo:interactive": "tsx --env-file=.env.local --env-file=.env scripts/demo-interactive.ts",
    "audit:export": "tsx --env-file=.env.local --env-file=.env scripts/audit-export.ts",
    "audit:verify": "tsx --env-file=.env.local --env-file=.env scripts/audit-export.ts --verify",
    "audit:csv": "tsx --env-file=.env.local --env-file=.env scripts/audit-export.ts --csv",
    "razorpay:proof": "tsx --env-file=.env.local --env-file=.env scripts/prove-razorpay-lifecycle.ts",
    "daemon": "tsx --env-file=.env.local --env-file=.env scripts/scheduler-daemon.ts",
    "daemon:once": "tsx --env-file=.env.local --env-file=.env scripts/scheduler-daemon.ts --once",
    "system:repair": "tsx --env-file=.env.local --env-file=.env scripts/repair-system-state.ts",
    "test:unit": "vitest run tests/unit",
    "test:state-transitions": "vitest run tests/integration --config vitest.integration.config.mts",
    "test:integration": "npm run test:state-transitions",
    "test:e2e": "playwright test",
    "test:razorpay:proof": "RUN_RAZORPAY_LIVE_E2E=1 playwright test tests/e2e/razorpay-provider.spec.ts --project=chromium",
    "test:razorpay:provider-contract": "npm run test:razorpay:proof",
    "test:integration:local": "docker-compose -f docker-compose.test.yml up -d && sleep 3 && DATABASE_URL=postgresql://postgres:postgres@localhost:51214/razorpay_integration_test npx prisma migrate deploy && DATABASE_URL=postgresql://postgres:postgres@localhost:51214/razorpay_integration_test vitest run tests/integration --config vitest.integration.config.mts && docker-compose -f docker-compose.test.yml down"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.62",
    "@ai-sdk/groq": "^4.0.37",
    "@ai-sdk/openai": "^4.0.47",
    "@ai-sdk/react": "^4.0.82",
    "@google/genai": "^2.18.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.10.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "ai": "^7.0.79",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
