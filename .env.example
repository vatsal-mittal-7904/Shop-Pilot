# Application Environment (production, test, demo)
# IMPORTANT: In 'demo' mode, live Razorpay keys are rejected.
APP_ENV=demo

# Database
DATABASE_URL=postgresql://root:rootpassword@localhost:51214/razorpay_test

# AI Providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Cryptographic Secrets
OFFER_BINDING_SECRET=
AUDIT_HMAC_SECRET=

# Razorpay Webhook & Payment Credentials (Optional for Demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local / Merchant Configuration
MERCHANT_ADMIN_EMAIL=
MERCHANT_ADMIN_PASSWORD=
NEXT_PUBLIC_APP_URL=http://localhost:3000
