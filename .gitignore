# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# One-off codemod scripts left in the repo root. Their edits are already applied to
# src/, so they are spent scratch -- kept on disk for reference, never committed.
# Same set the eslint config ignores.
/patch_*.js
/fix_*.js
/check_edges.js

# Local scratch: ad-hoc debug scripts, and graphify's generated knowledge graph
# (rebuildable from source, ~1k nodes of JSON + HTML).
/scratch/
/graphify-out/
.claude/settings.local.json

# playwright. /playwright/.auth holds a live merchantos_session cookie for the
# seeded merchant admin -- a real credential, never commit it. The rest is run
# output (reports, traces, videos), regenerated on every run.
/playwright/.auth/
/playwright/.cache/
/test-results/
/playwright-report/
/blob-report/
merchantos-audit-export-*.json
*.log
.pgdata/
